{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── Stratus, as anyone deploys it ─────────────────────────────────────────
  //
  // The top level is the template: what `npm run deploy` and the Deploy to
  // Cloudflare button create in *your* account. The database and the bucket
  // have names and no ids: Wrangler creates them on the first deploy and finds
  // them again by binding on every later one. The app answers on the
  // https://stratus.<you>.workers.dev address the deploy prints; add a custom
  // domain in the dashboard whenever you like, nothing here needs to change.
  "name": "stratus",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first: the cookie is checked before any file is served.
    "run_worker_first": true
  },

  "d1_databases": [{ "binding": "DB", "database_name": "stratus" }],

  // Defused message bodies live here as small JSON blobs, one per message.
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "stratus" }],

  // The same code, pinned to another region, for a request that could not
  // reach iCloud from where it landed (src/elsewhere.js). Holds no data.
  "durable_objects": { "bindings": [{ "name": "ELSEWHERE", "class_name": "Elsewhere" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Elsewhere"] }],

  "triggers": {
    // Two schedules, told apart by event.cron in the Worker.
    //
    // Every minute: the sync heartbeat — the finest granularity Cloudflare
    // offers. Each pass pulls a few messages per mailbox, so new mail is never
    // more than a minute behind. ~1,440 invocations/day against a 100,000/day
    // allowance, ~15 subrequests per pass against a 50-per-invocation ceiling.
    //
    // 03:17 UTC: the nightly database snapshot into R2. An odd minute on
    // purpose, so it does not land on the hour alongside every other cron job
    // on the platform.
    "crons": ["* * * * *", "17 3 * * *"]
  },

  "vars": {
    // Model for the compose assistant: Claude Opus 5.5. You are waiting on it
    // mid-sentence, so Fix and Improve ask it for low effort and a written
    // reply for medium (src/index.js, /api/assist) — that is what keeps it
    // quick, rather than a smaller model.
    //
    // A pinned id, not an alias: an alias moves under you, so the assistant
    // could change behaviour on a morning nothing here was touched. The picker
    // in Settings (backed by /api/ai-check) lists what the key can actually
    // use when it is time to move again.
    "CLAUDE_MODEL": "claude-opus-5-5"

    // Optional, both of them:
    //   APP_URL        "https://mail.example.com" — the public address. Without
    //                  it the app uses whatever host it was reached on.
    //   RELAY_DOMAINS  "example.com" — From addresses on these domains leave
    //                  through Cloudflare Email Sending instead of iCloud SMTP
    //                  (src/relay.js). Needs a "send_email": [{ "name": "EMAIL" }]
    //                  binding and the domain onboarded under Email Service.
  },

  "observability": { "enabled": true },

  // Secrets (npm run secrets, or the Deploy to Cloudflare form):
  //   AUTH_SECRET, BOOTSTRAP_KEY, ENC_KEY   — long random strings
  //   ANTHROPIC_API_KEY                     — optional, for the writing assistant
  //
  // The Anthropic key is only a starting point: one typed into the app (account
  // button → Writing assistant) is sealed into D1 and used ahead of this, so
  // rotating it never needs a terminal.
  //
  // The iCloud app-specific password is not here: it is entered in the app and
  // sealed into D1 with ENC_KEY, so it is per-account rather than per-Worker.

  // ── The maintainer's own instance ─────────────────────────────────────────
  //
  // mail.agentxr.app. Picked by CLOUDFLARE_ENV=dmzs in a local, untracked .env
  // file, which Wrangler reads for every command (deploy, secret put, tail, d1).
  // Bindings and vars are not inherited by an environment, so they are all
  // spelled out again; crons, assets and observability are.
  "env": {
    "dmzs": {
      "name": "dmzs-mail",
      "routes": [{ "pattern": "mail.agentxr.app", "custom_domain": true }],
      "d1_databases": [
        // Created 2026-08-12, WEUR.
        { "binding": "DB", "database_name": "dmzs-mail", "database_id": "1ec281be-33be-4c95-aee7-d735e6bc7b35" }
      ],
      "r2_buckets": [{ "binding": "MAIL", "bucket_name": "dmzs-mail" }],

      // Cloudflare Email Sending, for From addresses iCloud will not send as.
      // Requests run near Frankfurt rather than wherever they arrive. On
      // 2026-11-24 every outbound socket opened at Paris (CDG) died at once
      // with "Stream was cancelled.", so Delete, Archive and Star all answered
      // 502 from France while the cron, which runs elsewhere, kept syncing.
      // The database is in Western Europe as well, so nothing is further away.
      "placement": { "region": "aws:eu-central-1" },
      // Not inherited from the top level; see there.
      "durable_objects": { "bindings": [{ "name": "ELSEWHERE", "class_name": "Elsewhere" }] },

      "send_email": [{ "name": "EMAIL" }],

      // The Veille section (src/veille.js): the dmzs-digest Worker, reached
      // directly rather than over its public workers.dev address. Its reader
      // pages also check DIGEST_READER_TOKEN, set by dmzs-digest/agent/setup.py
      // --reader.
      "services": [{ "binding": "DIGEST", "service": "dmzs-digest" }],

      "vars": {
        "APP_URL": "https://mail.agentxr.app",
        "RELAY_DOMAINS": "agentxr.app",
        "CLAUDE_MODEL": "claude-opus-5-5"
      }
    }
  }
}
